# artef configuration. Copy to .env and fill in.
#
#   cp .env.example .env
#
# The whole install is the handful of values in the first block below, then
# `docker compose up -d` (spec §1.1, §10). Everything under "Defaults" already
# works; change those only to change behaviour, never to make it run.

# ── Fill these in ────────────────────────────────────────────────────────────

# The host Caddy serves and requests a certificate for. One DNS A record must
# point this name at the server.
DOMAIN=artef.company.com

# Public URL of the service. Same host as DOMAIN. Must match the Google OAuth
# redirect URI: https://artef.company.com/auth/google/callback
URL=https://artef.company.com

# Session signing key. Generate one and paste it here (minimum 32 characters):
#   openssl rand -hex 32
SECRET_KEY=

# Email domains allowed to sign in — comma-separated, no wildcard (spec §4.3).
# Consumer domains (gmail.com, etc.) are rejected.
ALLOWED_DOMAINS=company.com

# One Google OAuth client (APIs & Services → Credentials → OAuth client ID).
# Authorized redirect URI: https://artef.company.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Defaults (work as-is) ─────────────────────────────────────────────────────

# Which released image docker-compose.yml runs. Unset uses the version pinned
# in that file; `latest` tracks the most recent release. Published versions:
# https://github.com/Adarsh-Roy/artef/pkgs/container/artef
# ARTEF_VERSION=0.2.1

FILE_STORAGE=postgres            # where blobs live: postgres, or s3 (later milestone)
MAX_ARTIFACT_BYTES=10485760      # reject a push larger than this (10 MB, uncompressed)
MAX_VERSIONS=20                  # rolling version history kept per artifact
LINK_PREVIEW=name                # unfurls show the artifact name, or: none (spec §5.8)
FORCE_HTTPS=true                 # secure session cookies; leave true behind Caddy

# Password for the bundled postgres. Used only inside the compose network; the
# default works untouched, but change it before a real deployment.
POSTGRES_PASSWORD=change-me

# DATABASE_URL defaults to the bundled postgres (docker-compose.yml). Uncomment
# to point at an external/managed database instead — the value here is honored.
# DATABASE_URL=postgres://user:password@db-host:5432/artef
#
# PORT is fixed to 3000 by docker-compose.yml to match Caddy; no need to set it.
# PORT=3000

# ── Optional ─────────────────────────────────────────────────────────────────

# Generic OIDC instead of (or alongside) Google — issuer must serve discovery.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Company SSO

# Emails granted admin, comma-separated.
# ADMIN_EMAILS=

# Fold extra email domains into one workspace: 'sub.com=company.com,other.com=company.com'
# WORKSPACE_DOMAIN_MAP=
